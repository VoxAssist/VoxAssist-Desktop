<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VoxAssist.Desktop.Views.PermissionDialog"
        Title="Linux Permissions Required"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="20">
        <TextBlock Text="VoxAssist requires additional permissions to use /dev/uinput for keyboard injection."
                   FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Text="Without this, keyboard input will be very slow. Click 'Grant' to enter password."
                   TextWrapping="Wrap" FontSize="12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Not Now" Click="Later_Click"/>
            <Button Content="Grant" Click="Fix_Click" Background="#2196F3" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
