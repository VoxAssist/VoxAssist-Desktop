<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoxAssist.Desktop.ViewModels"
        xmlns:Views="using:VoxAssist.Desktop.Views"
        x:Class="VoxAssist.Desktop.Views.LlmEditDialog"
        x:DataType="vm:LlmViewModel"
        Title="AI Model Configuration" Width="400" Height="350"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Panel>
        <StackPanel x:Name="MainPanel" Margin="20" Spacing="10">
            <TextBlock Text="Host URL:"/>
            <TextBox Text="{Binding HostUrl}"/>
            
            <TextBlock Text="Model:"/>
            <TextBox Text="{Binding Model}"/>
            
            <TextBlock Text="API Key:"/>
            <TextBox Text="{Binding ApiKey}" PasswordChar="*"/>
            
            <CheckBox Content="Default" IsChecked="{Binding IsDefault}"/>
            
            <UniformGrid Columns="3" Margin="0,20,0,0">
                <Button x:Name="DeleteButton" Content="Delete" Background="#AA3333" Click="DeleteClick" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                <!-- Spacer if Delete is hidden -->
                <Panel x:Name="DeleteSpacer" IsVisible="False"/> 
                
                <Button Content="Cancel" Click="CancelClick" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,5,0"/>
                <Button Content="Save" Background="#33AA33" Click="SaveClick" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
            </UniformGrid>
        </StackPanel>

        <StackPanel x:Name="ConfirmationPanel" Margin="20" Spacing="20" IsVisible="False" VerticalAlignment="Center">
            <TextBlock Text="Are you sure you want to delete this AI model configuration?" 
                       TextWrapping="Wrap" TextAlignment="Center" FontSize="16"/>
            <UniformGrid Columns="2" HorizontalAlignment="Center" Width="300">
                <Button Content="Yes, Delete" Background="#AA3333" Click="ConfirmDeleteClick" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="No, Keep it" Click="CancelDeleteClick" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="10,0,0,0"/>
            </UniformGrid>
        </StackPanel>
    </Panel>
</Window>
