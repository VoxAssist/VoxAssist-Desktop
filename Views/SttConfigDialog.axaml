<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoxAssist.Desktop.ViewModels"
        x:Class="VoxAssist.Desktop.Views.SttConfigDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="STT Configuration" Width="400" Height="280"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="15">
        <StackPanel IsVisible="{Binding EditingGrokStt}" Spacing="10">
            <TextBlock Text="Grok API Key:"/>
            <TextBox Text="{Binding GrokApiKey}" PasswordChar="*"/>
            
            <TextBlock Text="Compression:" FontWeight="Bold" Margin="0,10,0,0"/>
            <ComboBox ItemsSource="{Binding CompressionTypes}" 
                      SelectedItem="{Binding SelectedCompression}" 
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource CompressionNameConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel IsVisible="{Binding EditingVoxStt}" Spacing="10">
            <TextBlock Text="VoxAssist Server Host URL:"/>
            <TextBox Text="{Binding VoxAssistHostUrl}"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="CancelClick" Width="100" HorizontalContentAlignment="Center"/>
            <Button Content="Save" Background="#33AA33" Click="SaveClick" Width="100" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>
