<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoxAssist.Desktop.ViewModels"
        xmlns:Views="using:VoxAssist.Desktop.Views"
        x:Class="VoxAssist.Desktop.Views.LlmEditDialog"
        x:DataType="vm:LlmViewModel"
        Title="AI Model Configuration" Width="400" Height="350"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Panel>
        <StackPanel x:Name="MainPanel" Margin="20" Spacing="10">
            <TextBlock Text="Provider:"/>
            <Grid ColumnDefinitions="*,Auto">
                <ComboBox ItemsSource="{Binding MainVm.AiProviders, RelativeSource={RelativeSource AncestorType=Views:LlmEditDialog}}" 
                          SelectedValue="{Binding ProviderName}" 
                          SelectedValueBinding="{Binding Name}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="+" Click="AddProviderClick" Margin="5,0,0,0" ToolTip.Tip="Add New Provider"/>
            </Grid>

            <TextBlock Text="Model Name:"/>
            <TextBox Text="{Binding Model}"/>

            <CheckBox Content="Set as Primary Model" IsChecked="{Binding IsDefault}"/>

            <UniformGrid Columns="2" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Delete" Background="#AA3333" Click="DeleteClick" 
                            IsVisible="{Binding !IsNew, RelativeSource={RelativeSource AncestorType=Views:LlmEditDialog}}"
                            Width="100" HorizontalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="CancelClick" Width="80" HorizontalContentAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Save" Background="#33AA33" Click="SaveClick" Width="80" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>

        <StackPanel x:Name="ConfirmationPanel" Margin="20" Spacing="20" IsVisible="False" VerticalAlignment="Center">
            <TextBlock Text="Are you sure you want to delete this AI model configuration?" 
                       TextWrapping="Wrap" TextAlignment="Center" FontSize="16"/>
            <UniformGrid Columns="2">
                <Button Content="Yes, Delete" Background="#AA3333" Click="ConfirmDeleteClick" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="No, Keep it" Click="CancelDeleteClick" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="10,0,0,0"/>
            </UniformGrid>
        </StackPanel>
    </Panel>
</Window>
