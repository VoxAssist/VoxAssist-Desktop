<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoxAssist.Desktop.ViewModels"
        xmlns:Views="using:VoxAssist.Desktop.Views"
        x:Class="VoxAssist.Desktop.Views.SttConfigDialog"
        x:DataType="Views:SttConfigDialog"
        x:Name="Root"
        Title="Speech to Text Configuration" Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="10" DataContext="{Binding #Root.MainVm}" x:DataType="vm:MainWindowViewModel">
        <!-- Grok Configuration -->
        <StackPanel IsVisible="{Binding EditingGrokStt}" Spacing="10">
            <TextBlock Text="Grok Provider:"/>
            <Grid ColumnDefinitions="*,Auto,Auto">
                <ComboBox ItemsSource="{Binding AiProviders}" 
                          SelectedValue="{Binding SttProviderName}" 
                          SelectedValueBinding="{Binding Name}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="Edit" Click="EditProviderClick" Margin="5,0,0,0" ToolTip.Tip="Edit Selected Provider"/>
                <Button Grid.Column="2" Content="+" Click="AddProviderClick" Margin="5,0,0,0" ToolTip.Tip="Add New Provider"/>
            </Grid>
            
            <TextBlock Text="Audio Compression:"/>
            <ComboBox ItemsSource="{Binding CompressionTypes}" SelectedItem="{Binding SelectedCompression}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource CompressionNameConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- VoxAssist Server Configuration -->
        <StackPanel IsVisible="{Binding EditingVoxStt}" Spacing="10">
            <TextBlock Text="Server Host URL:"/>
            <TextBox Text="{Binding VoxAssistHostUrl}" Watermark="http://localhost:5000"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="10">
            <Button Content="Cancel" Click="CancelClick" Width="100" HorizontalContentAlignment="Center"/>
            <Button Content="Save" Background="#33AA33" Click="SaveClick" Width="100" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>
