<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoxAssist.Desktop.ViewModels"
        xmlns:ctrl="using:VoxAssist.Desktop.Controls"
        xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="650"
        x:Class="VoxAssist.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="VoxAssist Desktop"
        Width="600" Height="650">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#2d2d2d" BorderBrush="#444" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid ColumnDefinitions="*,*">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Status:" Foreground="Gray"/>
                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                    <TextBlock Text="Microphone:" Foreground="Gray"/>
                    <TextBlock Text="{Binding MicStatus}" 
                               Foreground="{Binding MicStatus, Converter={StaticResource MicStatusColorConverter}}" 
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Conversation">
                <ListBox x:Name="ConversationListBox" 
                         ItemsSource="{Binding Conversation}" 
                         Background="White" 
                         BorderThickness="0"
                         Padding="0"
                         TemplateApplied="ConversationListBox_TemplateApplied">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="5,1"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#f0f0f0"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid PointerPressed="ConversationItem_PointerPressed" Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).CopyMessage}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Debug" Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ShowDebug}" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                
                                <md:MarkdownScrollViewer Markdown="{Binding DisplayMarkdown}" 
                                                        Margin="0"
                                                        HorizontalAlignment="Stretch"
                                                        IsHitTestVisible="False">
                                    <md:MarkdownScrollViewer.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </md:MarkdownScrollViewer.Styles>
                                </md:MarkdownScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="Actions">
                <Grid ColumnDefinitions="250,*">
                    <!-- Left: Action List -->
                    <DockPanel Grid.Column="0" Margin="10">
                        <Button DockPanel.Dock="Bottom" Content="Add Action" Command="{Binding AddAction}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <ListBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" Margin="0,0,0,10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Right: Editor -->
                    <ScrollViewer Grid.Column="1" Margin="10">
                        <StackPanel IsVisible="{Binding SelectedAction, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="15">
                            <TextBlock Text="Action" FontSize="20" FontWeight="Bold"/>
                            
                            <StackPanel Spacing="5">
                                <TextBlock Text="Name:"/>
                                <TextBox Text="{Binding SelectedAction.Name}"/>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Post-Processing AI Model:"/>
                                <ComboBox ItemsSource="{Binding LlmSelectorItems}" 
                                          SelectedItem="{Binding SelectedActionLlm}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Model}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Post-processing prompt:"/>
                                <TextBox Text="{Binding SelectedAction.Prompt}" 
                                         IsEnabled="{Binding IsPromptEnabled}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="150"/>
                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <CheckBox Content="Popup Window" IsChecked="{Binding SelectedAction.ShowPopup}"/>
                                    <CheckBox Content="Text to Speech" IsChecked="{Binding SelectedAction.UseTts}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,5,0,0">
                                <Button Content="Delete" Background="#AA3333" Command="{Binding DeleteSelectedAction}"/>
                                <Button Content="Save" 
                                        Background="{Binding CanSaveSelectedAction, Converter={StaticResource SaveButtonColorConverter}}" 
                                        Command="{Binding SaveSelectedAction}" 
                                        IsEnabled="{Binding CanSaveSelectedAction}"/>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Keyboard Hotkey:"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding SelectedAction.HotkeyDisplay}" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="Set Hotkey" Command="{Binding SetActionHotkey}" Margin="5,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="ReSpeaker">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="20">
                        <!-- ReSpeaker Controls -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Mic Array v2.0 Controls" FontSize="18" FontWeight="Bold"/>
                            
                            <Border BorderBrush="#333" BorderThickness="1" Padding="15" CornerRadius="8">
                                <StackPanel Spacing="15">
                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="Connection Status:" Foreground="Gray"/>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="10" Height="10" Fill="{Binding IsRespeakerConnected, Converter={StaticResource BoolToColorConverter}}"/>
                                                <TextBlock Text="{Binding IsRespeakerConnected, Converter={StaticResource BoolToConnectedConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Reconnect" Command="{Binding ReconnectRespeaker}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Separator Background="#333"/>

                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Text="Brightness:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="{Binding MaxBrightness}" Value="{Binding Brightness}"/>
                                        
                                        <TextBlock Grid.Row="1" Text="Pattern:" VerticalAlignment="Center" Margin="0,10,10,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" 
                                                  ItemsSource="{Binding LedPatterns}"
                                                  SelectedItem="{Binding LedPattern}"
                                                  HorizontalAlignment="Stretch"/>
                                    </Grid>

                                    <Separator Background="#333"/>

                                    <Grid ColumnDefinitions="*,*">
                                        <CheckBox Content="AGC (Auto Gain)" IsChecked="{Binding IsAgcEnabled}"/>
                                        <CheckBox Grid.Column="1" Content="AEC (Echo Cancel)" IsChecked="{Binding IsAecEnabled}"/>
                                    </Grid>
                                    <CheckBox Content="Noise Suppression" IsChecked="{Binding IsNsEnabled}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- DOA Visualization -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Direction of Arrival (DOA)" FontSize="16" FontWeight="Bold"/>
                            <Border BorderBrush="#333" BorderThickness="1" Padding="20" CornerRadius="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ctrl:CompassControl Angle="{Binding DoaAngle}" IsCcw="{Binding IsCcw}" Width="220" Height="220" HorizontalAlignment="Center"/>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" Margin="20,0,0,0">
                                        <CheckBox Content="Counter-Clockwise" IsChecked="{Binding IsCcw}"/>
                                        <CheckBox Content="Freeze" IsChecked="{Binding IsFreezeEnabled}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="10">
                        <TextBlock Text="Microphone:" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding AvailableMics}" 
                                  SelectedItem="{Binding SelectedMic}" 
                                  HorizontalAlignment="Stretch"/>

                        <TextBlock Text="Speech to Text" FontSize="18" FontWeight="Bold" Margin="0,10,0,0"/>
                        <Border BorderBrush="#333" BorderThickness="1" Padding="15" CornerRadius="8" Margin="0,5,0,0">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <RadioButton Content="Grok (xAI)" IsChecked="{Binding IsGrokStt}"/>
                                    <Button Grid.Column="1" Content="Edit" Command="{Binding EditGrokStt}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <RadioButton Content="VoxAssist-Server" IsChecked="{Binding IsGrokStt, Converter={StaticResource InverseBoolConverter}}"/>
                                    <Button Grid.Column="1" Content="Edit" Command="{Binding EditVoxStt}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Separator Background="#333" Margin="0,20"/>

                        <TextBlock Text="AI Models" FontSize="18" FontWeight="Bold"/>
                        <DockPanel Margin="0,10,0,0" LastChildFill="True">
                            <Button DockPanel.Dock="Bottom" Content="Add AI Model" Command="{Binding AddLlm}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
                            <ListBox ItemsSource="{Binding Llms}" SelectedItem="{Binding SelectedLlm}" 
                                     DoubleTapped="LlmDoubleTapped"
                                     Height="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>
