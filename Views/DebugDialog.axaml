<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoxAssist.Desktop.ViewModels"
        xmlns:m="using:VoxAssist.Desktop.Models"
        x:Class="VoxAssist.Desktop.Views.DebugDialog"
        x:DataType="m:InteractionRecord"
        Title="Interaction Debug"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Action Selected:" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
            <TextBlock Text="{Binding ActionName}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <Separator Margin="0,5,0,0"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Content="Close" Click="Close_Click" HorizontalAlignment="Right" Margin="0,10,0,0"/>
        
        <TabControl>
            <TabItem Header="Raw STT">
                <TextBox Text="{Binding RawStt}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
            </TabItem>
            <TabItem Header="LLM Request">
                <TextBox Text="{Binding LlmRequest}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
            </TabItem>
            <TabItem Header="LLM Response">
                <TextBox Text="{Binding LlmResponse}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
